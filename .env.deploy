# Non-secret deploy configuration, loaded into CI by falti/dotenv-action.
# (.env itself is gitignored and reserved for local runtime overrides.)
GCP_PROJECT_ID=songbook-generator
GCP_REGION=europe-west1
GCP_VERTEX_LOCATION=us-central1
API_FUNCTION_NAME=setlister-api
CORS_ALLOWED_ORIGINS=["https://ukuleletuesday.github.io"]

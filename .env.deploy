# Non-secret deploy configuration, loaded into CI by falti/dotenv-action.
# (.env itself is gitignored and reserved for local runtime overrides.)
GCP_PROJECT_ID=songbook-generator
GCP_REGION=europe-west1
GCP_VERTEX_LOCATION=us-central1
API_FUNCTION_NAME=setlister-api
CORS_ALLOWED_ORIGINS=["https://ukuleletuesday.github.io"]
# CI authenticates via Workload Identity Federation (keyless) — see the
# one-time setup in the README. 993670465212 is the songbook-generator
# project number.
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/993670465212/locations/global/workloadIdentityPools/github/providers/github-oidc
GCP_DEPLOYER_SERVICE_ACCOUNT=setlister-deployer@songbook-generator.iam.gserviceaccount.com

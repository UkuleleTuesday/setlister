rules_version = '2';

// Access control for realtime collaborative sessions (epic #25). The browser
// reads/writes sessions/{id} directly via the Firebase Web SDK — there is no
// backend sync endpoint, so these rules are the ENTIRE access-control layer.
//
// Deliberately unauthenticated (see the epic's "accepted risks"): anyone can
// read any session, and anyone who knows/guesses an id can write it. The
// defence is a closed schema (hasOnly locks the key set) + deny-by-default
// everywhere else.
//
// Sessions are now KEPT FOREVER (#77): the app opens on the club's session
// history, so a night that disappears after 30 days is a bug, not a feature.
// New clients write no `expiresAt` at all and strip it from legacy docs on
// first write. The field stays in the allowed key set purely so docs created
// before that change (and browsers still running a cached bundle) keep
// validating through the rollout.
//
// Two sibling collections keep the session doc small and stable:
//   - sessions/{id}/presence/{clientId} — "who's here" heartbeats (#32), so a
//     churning beat never rewrites the durable state.
//   - sessionIndex/{id} — the ~120-byte listing row the home screen reads, so
//     listing history doesn't download every session's rows.
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{id} {
      allow read: if true;                        // public by design
      allow create, update: if isValidSession(id);
      allow delete: if false;                     // history is kept forever

      // Ephemeral presence heartbeats. Same unauthenticated posture as the
      // parent: readable by anyone with the id, and each client owns its own
      // doc (keyed by a client id). Unlike the parent, delete is allowed so a
      // client can retract its own presence on leave.
      match /presence/{clientId} {
        allow read: if true;
        allow create, update: if isValidPresence();
        allow delete: if true;
      }
    }

    // Club-wide session history (#77). One tiny doc per LISTED session, same id
    // as the session it points at, written in the same transaction that mints
    // the session. The home screen queries this collection instead of
    // `sessions` because the Web SDK has no field projection — listing sessions
    // directly would pull every row of every night, forever, on every app open.
    //
    // A session marked unlisted simply has no doc here. That is NOT access
    // control: the session itself stays world-readable by id, exactly like
    // every other session. Unlisted means "not advertised in the club's list".
    match /sessionIndex/{id} {
      allow read: if true;                        // public by design, like sessions
      allow create: if isValidIndexEntry(id);
      // Nothing user-facing is mutable — provenance is not rewritable. Update
      // stays open (with the same immutability pins) because re-listing a
      // session set()s over any row a racing client already wrote.
      allow update: if isValidIndexEntry(id)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      // Needed so a session can be un-listed after the fact. Accepted risk, and
      // the same trust model as "anyone can edit any session" — but strictly
      // weaker: the session doc itself is `delete: if false`, so only the
      // listing can be lost here, never the setlist.
      allow delete: if true;
    }

    // Deny-by-default: everything not matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidSession(id) {
  let d = request.resource.data;
  // Session ids are `adjective-noun`, lowercase, one dash (e.g. misty-banjo).
  return id.matches('^[a-z]+-[a-z]+$')
    && d.keys().hasOnly(['v', 'rows', 'upNextOrder', 'requestsOrder', 'edition', 'name', 'createdBy', 'listed', 'requestsOpen', 'createdAt', 'updatedAt', 'expiresAt'])
    && d.v == 1
    && d.rows is map
    && d.upNextOrder is list
    && d.requestsOrder is list
    && d.createdAt is timestamp
    && d.updatedAt is timestamp
    // The display fields are checked only when present: sessions created before
    // #77 carry none of them, and on an update `request.resource.data` is the
    // MERGED document — an unconditional check would make every legacy session
    // unwritable.
    // `name` is legacy-only (sessions are identified by their date now): never
    // written by current clients, but kept in the key set — dropping it would
    // make every named legacy session unwritable, exactly like `expiresAt`.
    && (!('name' in d) || (d.name is string && d.name.size() <= 80))
    && (!('createdBy' in d) || (d.createdBy is string && d.createdBy.size() <= 60))
    && (!('listed' in d) || d.listed is bool)
    // Whether the room's request link still accepts tunes (#86). Like room mode
    // itself this is a VIEW, not a permission: `rows` below is an unvalidated
    // map and anyone with the id can write, so closing requests stops the
    // ordinary case (a link still circulating in the WhatsApp group), not a
    // determined one. Absent means open, so no session predating the field
    // silently shuts.
    && (!('requestsOpen' in d) || d.requestsOpen is bool)
    // Legacy TTL field, tolerated but never written by current clients (see the
    // header). No cap: sessions are kept forever now, so the old
    // "expiresAt <= now + 31d" ceiling has nothing left to bound.
    && (!('expiresAt' in d) || d.expiresAt is timestamp);
  // `edition` (map | null) is intentionally not type-constrained: hasOnly
  // already caps the key set, and null vs map is validated client-side.
}

// A history listing row: who started the session, and when its night is. No
// name — the date IS the identity, rendered client-side in each viewer's own
// locale. Closed key set with bounded strings, matching the session doc's caps.
// (Legacy rows may still carry a `name`; it is ignored on read and dropped
// whenever the row is rewritten — set() replaces the whole doc.)
function isValidIndexEntry(id) {
  let d = request.resource.data;
  return id.matches('^[a-z]+-[a-z]+$')
    && d.keys().hasOnly(['v', 'createdBy', 'createdAt'])
    && d.v == 1
    && d.createdBy is string
    && d.createdBy.size() <= 60
    // A session can be created AHEAD of its night (prepping next Tuesday's
    // set), and a future night sorting to the top of the date-ordered list is
    // exactly where the club wants it. The 60-day cap is the anti-garbage
    // bound: far enough for any real planning, near enough that a bogus write
    // can't pin itself to the top for years.
    && d.createdAt is timestamp
    && d.createdAt <= request.time + duration.value(60, 'd');
  // NB: do NOT add an exists() check that the matching session doc is there.
  // Rules see pre-commit state, so inside the transaction that mints a session
  // the doc doesn't exist yet and the index write would be denied.
}

// A presence heartbeat: a short display name plus two timestamps. Closed key
// set + a bounded name length, and a hard cap on the doc's lifetime so an
// abandoned heartbeat can't outlive the TTL sweep.
function isValidPresence() {
  let d = request.resource.data;
  return d.keys().hasOnly(['name', 'updatedAt', 'expiresAt'])
    && d.name is string
    && d.name.size() <= 60
    && d.updatedAt is timestamp
    && d.expiresAt is timestamp
    && d.expiresAt <= request.time + duration.value(1, 'h');
}

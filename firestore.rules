rules_version = '2';

// Access control for realtime collaborative sessions (epic #25). The browser
// reads/writes sessions/{id} directly via the Firebase Web SDK — there is no
// backend sync endpoint, so these rules are the ENTIRE access-control layer.
//
// Anyone can read any session. Writes are organisers' (#150): a phone signed
// in anonymously with a current `organisers` row. Everyone else may only add
// one request and toggle votes (isRoomWrite). A closed schema (hasOnly locks
// the key set) and deny-by-default cover the rest.
//
// Sessions are now KEPT FOREVER (#77): the app opens on the club's session
// history, so a night that disappears after 30 days is a bug, not a feature.
// New clients write no `expiresAt` at all and strip it from legacy docs on
// first write. The field stays in the allowed key set purely so docs created
// before that change (and browsers still running a cached bundle) keep
// validating through the rollout.
//
// Two sibling collections keep the session doc small and stable:
//   - sessions/{id}/presence/{clientId} — "who's here" heartbeats (#32), so a
//     churning beat never rewrites the durable state.
//   - sessionIndex/{id} — the ~120-byte listing row the home screen reads, so
//     listing history doesn't download every session's rows.
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{id} {
      allow read: if true;                        // public by design
      allow create: if isValidSession(id) && isOrganiser();
      allow update: if isValidSession(id) && (isOrganiser() || isRoomWrite());
      allow delete: if false;                     // history is kept forever

      // Ephemeral presence heartbeats. Same unauthenticated posture as the
      // parent: readable by anyone with the id, and each client owns its own
      // doc (keyed by a client id). Unlike the parent, delete is allowed so a
      // client can retract its own presence on leave.
      match /presence/{clientId} {
        allow read: if true;
        allow create, update: if isValidPresence();
        allow delete: if true;
      }
    }

    // Club-wide session history (#77). One tiny doc per LISTED session, same id
    // as the session it points at, written in the same transaction that mints
    // the session. The home screen queries this collection instead of
    // `sessions` because the Web SDK has no field projection — listing sessions
    // directly would pull every row of every night, forever, on every app open.
    //
    // A session marked unlisted simply has no doc here. That is NOT access
    // control: the session itself stays world-readable by id, exactly like
    // every other session. Unlisted means "not advertised in the club's list".
    match /sessionIndex/{id} {
      allow read: if true;                        // public by design, like sessions
      allow create: if isValidIndexEntry(id) && isOrganiser();
      // Provenance is not rewritable. Update stays possible because re-listing
      // set()s over any row a racing client already wrote.
      allow update: if isValidIndexEntry(id) && isOrganiser()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      // Un-listing. The session doc itself can't be deleted.
      allow delete: if isOrganiser();
    }

    // The key in the write is the credential (#151). update = re-registering
    // after a key change.
    match /organisers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'key'])
        && request.resource.data.key == currentKey()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow delete: if false;   // console only
    }

    // Holds the organiser key: console only.
    match /clubConfig/{doc} {
      allow read, write: if false;
    }

    // Inside this block: $(database) is undefined at file level.
    function currentKey() {
      return get(/databases/$(database)/documents/clubConfig/organiserKey).data.key;
    }

    // A row counts only while its key is current, so changing the key
    // de-registers everyone.
    function isOrganiser() {
      return request.auth != null && hasCurrentRow(request.auth.uid);
    }

    function hasCurrentRow(uid) {
      let path = /databases/$(database)/documents/organisers/$(uid);
      return exists(path) && get(path).data.key == currentKey();
    }

    // The room's only write (sync.ts roomRequestUpdates / roomVoteUpdates):
    // add one request, or toggle vote leaves, plus updatedAt. Existing rows
    // and both orders are untouched.
    function isRoomWrite() {
      let before = resource.data;
      let after = request.resource.data;
      let rows = after.rows.diff(before.rows);
      return after.diff(before).affectedKeys().hasOnly(['rows', 'requestsOrder', 'votes', 'updatedAt'])
        && after.updatedAt == request.time
        && rows.removedKeys().size() == 0
        && rows.changedKeys().size() == 0
        && ((rows.addedKeys().size() == 0 && after.requestsOrder == before.requestsOrder)
            || isNewRoomRequest(before, after))
        && roomVotesOk(before, after);
    }

    // The new row's uid is requestsOrder's last element (arrayUnion appends):
    // sets have no element access, so that's how the rule finds it.
    function isNewRoomRequest(before, after) {
      let order = after.requestsOrder;
      let uid = order[order.size() - 1];
      let row = after.rows[uid];
      return order.size() == before.requestsOrder.size() + 1
        && order.hasAll(before.requestsOrder)
        && after.rows.diff(before.rows).addedKeys().hasOnly([uid])
        && row.keys().hasOnly(['uid', 'source', 'addedBy', 'raw_title', 'raw_page', 'notes',
             'crossed_out', 'status', 'method', 'confidence', 'match', 'alternatives',
             'explanation', 'removed', 'played', 'binned'])
        && row.uid == uid
        && row.source == 'room'
        && row.removed == false && row.played == false && row.binned == false
        && row.raw_title is string && row.raw_title.size() <= 200
        && row.addedBy is string && row.addedBy.size() <= 60
        && (row.notes == null || (row.notes is string && row.notes.size() <= 120));
    }

    // At most one row's votes change, that row exists, and no row's votes go.
    // Who voted inside a row stays on trust.
    function roomVotesOk(before, after) {
      let v = after.get('votes', {}).diff(before.get('votes', {}));
      return v.removedKeys().size() == 0
        && v.affectedKeys().size() <= 1
        && v.affectedKeys().hasOnly(after.rows.keys());
    }

    // Deny-by-default: everything not matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidSession(id) {
  let d = request.resource.data;
  // Session ids are `adjective-noun`, lowercase, one dash (e.g. misty-banjo).
  return id.matches('^[a-z]+-[a-z]+$')
    && d.keys().hasOnly(['v', 'rows', 'upNextOrder', 'requestsOrder', 'edition', 'name', 'createdBy', 'listed', 'requestsOpen', 'requestsOpensAt', 'requestsClosesAt', 'votes', 'createdAt', 'updatedAt', 'expiresAt'])
    && d.v == 1
    && d.rows is map
    && d.upNextOrder is list
    && d.requestsOrder is list
    && d.createdAt is timestamp
    && d.updatedAt is timestamp
    // The display fields are checked only when present: sessions created before
    // #77 carry none of them, and on an update `request.resource.data` is the
    // MERGED document — an unconditional check would make every legacy session
    // unwritable.
    // `name` is legacy-only (sessions are identified by their date now): never
    // written by current clients, but kept in the key set — dropping it would
    // make every named legacy session unwritable, exactly like `expiresAt`.
    && (!('name' in d) || (d.name is string && d.name.size() <= 80))
    && (!('createdBy' in d) || (d.createdBy is string && d.createdBy.size() <= 60))
    && (!('listed' in d) || d.listed is bool)
    // Whether the room's request link still accepts tunes (#86, #127). Like
    // room mode itself this is a VIEW, not a permission: `rows` below is an
    // unvalidated map and anyone with the id can write, so closing requests
    // stops the ordinary case (a link still circulating in the WhatsApp
    // group), not a determined one. Tri-state now: true/false force the link
    // open/closed regardless of the window below; absent means AUTO — follow
    // requestsOpensAt/requestsClosesAt (or their smart defaults, derived
    // client-side from createdAt when neither is set). The rules check is
    // unchanged from #86: only the client's reading of "absent" changed, so
    // no schema migration is needed here.
    && (!('requestsOpen' in d) || d.requestsOpen is bool)
    // Overrides for the request window (#127): when the link opens/closes on
    // its own, beyond the smart default above. Both optional and independent
    // — moving the close time never pins the open time to anything. Written
    // only from the share panel once a session exists, never on create (see
    // createSession() in ui/sync.ts) so a UI bundle running ahead of these
    // rules can't turn "start a session" into a hasOnly rejection. No bound
    // beyond `is timestamp`: unlike sessionIndex's createdAt, a bogus value
    // here can't pollute a shared list — it only breaks this one session's
    // own window for whoever opens it, the same trust level `rows` already
    // carries.
    && (!('requestsOpensAt' in d) || d.requestsOpensAt is timestamp)
    && (!('requestsClosesAt' in d) || d.requestsClosesAt is timestamp)
    // Upvotes on requests (#83): { rowUid: { clientId: true } }. Its own
    // top-level map rather than a field on the row, because `rows.<uid>` writes
    // replace the whole row (see diff() in ui/sync.ts) — votes living there
    // would clobber each other in exactly the moment the room all votes at
    // once. Only `is map`: the contents are as unvalidated as `rows`, and
    // one-vote-per-person is a client-side honour rule, not something rules can
    // enforce without auth.
    && (!('votes' in d) || d.votes is map)
    // Legacy TTL field, tolerated but never written by current clients (see the
    // header). No cap: sessions are kept forever now, so the old
    // "expiresAt <= now + 31d" ceiling has nothing left to bound.
    && (!('expiresAt' in d) || d.expiresAt is timestamp);
  // `edition` (map | null) is intentionally not type-constrained: hasOnly
  // already caps the key set, and null vs map is validated client-side.
}

// A history listing row: who started the session, and when its night is. No
// name — the date IS the identity, rendered client-side in each viewer's own
// locale. Closed key set with bounded strings, matching the session doc's caps.
// (Legacy rows may still carry a `name`; it is ignored on read and dropped
// whenever the row is rewritten — set() replaces the whole doc.)
function isValidIndexEntry(id) {
  let d = request.resource.data;
  return id.matches('^[a-z]+-[a-z]+$')
    && d.keys().hasOnly(['v', 'createdBy', 'createdAt'])
    && d.v == 1
    && d.createdBy is string
    && d.createdBy.size() <= 60
    // A session can be created AHEAD of its night (prepping next Tuesday's
    // set), and a future night sorting to the top of the date-ordered list is
    // exactly where the club wants it. The 60-day cap is the anti-garbage
    // bound: far enough for any real planning, near enough that a bogus write
    // can't pin itself to the top for years.
    && d.createdAt is timestamp
    && d.createdAt <= request.time + duration.value(60, 'd');
  // NB: do NOT add an exists() check that the matching session doc is there.
  // Rules see pre-commit state, so inside the transaction that mints a session
  // the doc doesn't exist yet and the index write would be denied.
}

// A presence heartbeat: a short display name plus two timestamps. Closed key
// set + a bounded name length, and a hard cap on the doc's lifetime so an
// abandoned heartbeat can't outlive the TTL sweep.
function isValidPresence() {
  let d = request.resource.data;
  return d.keys().hasOnly(['name', 'updatedAt', 'expiresAt'])
    && d.name is string
    && d.name.size() <= 60
    && d.updatedAt is timestamp
    && d.expiresAt is timestamp
    && d.expiresAt <= request.time + duration.value(1, 'h');
}

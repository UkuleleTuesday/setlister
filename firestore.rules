rules_version = '2';

// The browser writes Firestore directly, so these rules are the whole
// access-control layer. Behaviour is pinned by ui/tests/rules.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{id} {
      allow read: if true;
      allow create: if isValidSession(id) && isOrganiser();
      allow update: if isValidSession(id) && (isOrganiser() || isRoomWrite());
      allow delete: if false;

      // A subcollection so heartbeats never rewrite the session doc. Delete
      // lets a client retract its own presence on leave.
      match /presence/{clientId} {
        allow read: if true;
        allow create, update: if isValidPresence();
        allow delete: if true;
      }
    }

    // The home screen lists this, not `sessions`: the Web SDK has no field
    // projection. Unlisted means no row here; it is not access control.
    match /sessionIndex/{id} {
      allow read: if true;
      allow create: if isValidIndexEntry(id) && isOrganiser();
      // Re-listing set()s over a row a racing client already wrote.
      allow update: if isValidIndexEntry(id) && isOrganiser()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isOrganiser();
    }

    // The key in the write is the credential. update = re-registering after a
    // key change.
    match /organisers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'key'])
        && request.resource.data.key == currentKey()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    // Holds the organiser key, set from the console.
    match /clubConfig/{doc} {
      allow read, write: if false;
    }

    // These must live inside this block: $(database) is undefined at file level.
    function currentKey() {
      return get(/databases/$(database)/documents/clubConfig/organiserKey).data.key;
    }

    function isOrganiser() {
      return request.auth != null && hasCurrentRow(request.auth.uid);
    }

    function hasCurrentRow(uid) {
      let path = /databases/$(database)/documents/organisers/$(uid);
      return exists(path) && get(path).data.key == currentKey();
    }

    // Mirrors sync.ts roomRequestUpdates / roomVoteUpdates.
    function isRoomWrite() {
      let before = resource.data;
      let after = request.resource.data;
      let rows = after.rows.diff(before.rows);
      return roomIsTakingRequests(before)
        && after.diff(before).affectedKeys().hasOnly(['rows', 'requestsOrder', 'votes', 'updatedAt'])
        && after.updatedAt == request.time
        && rows.removedKeys().size() == 0
        && rows.changedKeys().size() == 0
        && ((rows.addedKeys().size() == 0 && after.requestsOrder == before.requestsOrder)
            || isNewRoomRequest(before, after))
        && roomVotesOk(before, after);
    }

    // Mirrors request-window.ts linkState plus session-index.ts isPastNight, as
    // a superset: the room view must never offer a write these refuse. Rules
    // have no time zones, so the local-time bounds (the 22:30 or 04:00 default
    // close, the night's end at the next local 04:00) become `nightEnd`, which
    // is later than both: a night ends at most a day after it starts, plus a
    // DST hour. `grace` covers phone clocks running fast or slow.
    function roomIsTakingRequests(d) {
      let mode = d.get('requestsOpen', null);
      let start = d.createdAt;
      let grace = duration.value(5, 'm');
      let nightEnd = start + duration.value(25, 'h');
      let opens = d.get('requestsOpensAt', start - duration.value(2, 'h'));
      let closes = d.get('requestsClosesAt', nightEnd);
      // With only opensAt set, the client fails open when its default close
      // falls at or before it, and that close is only known to be after `start`.
      let opensBinds = 'requestsClosesAt' in d || opens <= start;
      return mode != false
        && request.time < nightEnd + grace
        && (mode == true
            || closes <= opens
            || ((!opensBinds || request.time >= opens - grace) && request.time < closes + grace));
    }

    // The new row's uid is requestsOrder's last element (arrayUnion appends):
    // sets have no element access, so that's how the rule finds it.
    function isNewRoomRequest(before, after) {
      let order = after.requestsOrder;
      let uid = order[order.size() - 1];
      let row = after.rows[uid];
      return order.size() == before.requestsOrder.size() + 1
        && order.hasAll(before.requestsOrder)
        && after.rows.diff(before.rows).addedKeys().hasOnly([uid])
        && row.keys().hasOnly(['uid', 'source', 'addedBy', 'raw_title', 'raw_page', 'notes',
             'crossed_out', 'status', 'method', 'confidence', 'match', 'alternatives',
             'explanation', 'removed', 'played', 'binned'])
        && row.uid == uid
        && row.source == 'room'
        && row.removed == false && row.played == false && row.binned == false
        && row.raw_title is string && row.raw_title.size() <= 200
        && row.addedBy is string && row.addedBy.size() <= 60
        && (row.notes == null || (row.notes is string && row.notes.size() <= 120));
    }

    // Who voted inside a row stays on trust.
    function roomVotesOk(before, after) {
      let v = after.get('votes', {}).diff(before.get('votes', {}));
      return v.removedKeys().size() == 0
        && v.affectedKeys().size() <= 1
        && v.affectedKeys().hasOnly(after.rows.keys());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidSession(id) {
  let d = request.resource.data;
  return id.matches('^[a-z]+-[a-z]+$')
    // A new field needs its entry here in the same change: PR previews run new
    // code against production's rules. Dropping one breaks every write to a doc
    // that still has it, room requests included.
    && d.keys().hasOnly(['v', 'rows', 'upNextOrder', 'requestsOrder', 'edition', 'createdBy', 'listed', 'blurb', 'requestsOpen', 'requestsOpensAt', 'requestsClosesAt', 'votes', 'createdAt', 'updatedAt'])
    && d.v == 1
    && d.rows is map
    && d.upNextOrder is list
    && d.requestsOrder is list
    && d.createdAt is timestamp
    && d.updatedAt is timestamp
    // Optional fields are checked only when present: on update this is the
    // merged doc, and legacy sessions lack them.
    && (!('createdBy' in d) || (d.createdBy is string && d.createdBy.size() <= 60))
    && (!('listed' in d) || d.listed is bool)
    && (!('blurb' in d) || (d.blurb is string && d.blurb.size() <= 160))
    && (!('requestsOpen' in d) || d.requestsOpen is bool)
    // Unbounded: a bogus window only breaks this one session.
    && (!('requestsOpensAt' in d) || d.requestsOpensAt is timestamp)
    && (!('requestsClosesAt' in d) || d.requestsClosesAt is timestamp)
    // Top-level so concurrent votes merge: a `rows.<uid>` write replaces the
    // whole row. One vote per person is a client-side honour rule.
    && (!('votes' in d) || d.votes is map);
  // `edition` (map | null) is validated client-side.
}

// Legacy rows may carry `name`; set() replaces the doc, so a rewrite drops it.
function isValidIndexEntry(id) {
  let d = request.resource.data;
  return id.matches('^[a-z]+-[a-z]+$')
    && d.keys().hasOnly(['v', 'createdBy', 'createdAt', 'blurb'])
    && d.v == 1
    && d.createdBy is string
    && d.createdBy.size() <= 60
    && (!('blurb' in d) || (d.blurb is string && d.blurb.size() <= 160))
    // Future nights are fine (prepping next week); the cap stops a bogus row
    // pinning itself to the top of the list for years.
    && d.createdAt is timestamp
    && d.createdAt <= request.time + duration.value(60, 'd');
  // No exists() check on the session: rules see pre-commit state, so in the
  // transaction that mints the session it doesn't exist yet.
}

function isValidPresence() {
  let d = request.resource.data;
  return d.keys().hasOnly(['name', 'updatedAt', 'expiresAt'])
    && d.name is string
    && d.name.size() <= 60
    && d.updatedAt is timestamp
    && d.expiresAt is timestamp
    // So an abandoned heartbeat can't outlive the TTL sweep.
    && d.expiresAt <= request.time + duration.value(1, 'h');
}

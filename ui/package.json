{
  "name": "setlister-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:emulator": "npx --yes firebase-tools@15.26.0 emulators:exec --only firestore --config ../firebase.json --project demo-setlister \"vitest run\"",
    "test:e2e": "npx --yes firebase-tools@15.26.0 emulators:exec --only firestore --config ../firebase.json --project demo-setlister \"playwright test\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "lucide": "^1.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
